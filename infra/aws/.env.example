# Real AWS credentials for Terraform and Bedrock.
#
# Copy to .env in this directory:
#   cp .env.example .env
#
# Read only when you source it from infra/aws. The project-root .env is a
# different file with the same variable names pointing at MinIO, and
# docker-compose reads that one. Keeping them separate is why the standard
# AWS_* names are safe here.
#
# `export` matters: sourcing a file without it sets shell variables that
# terraform, as a child process, never sees.

export AWS_ACCESS_KEY_ID=
export AWS_SECRET_ACCESS_KEY=
export AWS_DEFAULT_REGION=us-east-1

# Clear the MinIO endpoint in case the project-root .env was sourced in this
# shell first. Without this, real AWS calls are sent to http://minio:9000 and
# fail with: dial tcp: lookup minio: no such host
unset AWS_ENDPOINT_URL
