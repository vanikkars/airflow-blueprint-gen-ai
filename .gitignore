# Temporary files
*.tmp
*.bak
/tmp/

# Terraform
# State can contain secrets in cleartext (e.g. IAM access keys).
*.tfstate
*.tfstate.*
*.tfstate.backup
.terraform/
.terraform.lock.hcl
crash.log
# Real variable values; commit only the .example files.
terraform.tfvars
terraform.auto.tfvars
