# Airflow Configuration
AIRFLOW_UID=501
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# Postgres Source Configuration
SOURCE_POSTGRES_HOST=postgres-source
SOURCE_POSTGRES_PORT=5432
SOURCE_POSTGRES_DB=sourcedb
SOURCE_POSTGRES_USER=sourceuser
SOURCE_POSTGRES_PASSWORD=sourcepass

# MinIO/S3 Configuration (LOCAL only - these are MinIO's root credentials,
# hardcoded as minioadmin/minioadmin in docker-compose. Do not put real AWS
# credentials here - see infra/aws/.env.)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1

# Optional GitHub integration (leave empty if not using)
GITHUB_TOKEN=
GITHUB_REPO=

# Iceberg catalog (REST catalog service, state persisted in Postgres)
ICEBERG_CATALOG_URI=http://iceberg-rest:8181