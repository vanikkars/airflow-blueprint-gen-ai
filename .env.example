# Airflow Configuration
AIRFLOW_UID=501
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW__CORE__FERNET_KEY=

# Signs the JWTs the Task SDK uses to call back into the api-server (Airflow 3).
AIRFLOW__API_AUTH__JWT_SECRET=airflow_jwt_secret


# Banking source Postgres (values are hardcoded in docker-compose.yml;
# these are here for reference and for scripts run from the host)
BANKING_POSTGRES_HOST=postgres-banking
BANKING_POSTGRES_PORT=5433
BANKING_POSTGRES_DB=bankingdb
BANKING_POSTGRES_USER=bankinguser
BANKING_POSTGRES_PASSWORD=bankingpass

# MinIO/S3 Configuration (LOCAL only - these are MinIO's root credentials,
# hardcoded as minioadmin/minioadmin in docker-compose. Do not put real AWS
# credentials here - see infra/aws/.env.)
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_ENDPOINT_URL=http://minio:9000
AWS_DEFAULT_REGION=us-east-1


# Iceberg catalog (REST catalog service, state persisted in Postgres)
ICEBERG_CATALOG_URI=http://iceberg-rest:8181


# --- dag_generator (make gen / make wizard) ---------------------------------
# `make wizard` needs none of this: it validates against the blueprint registry
# and the source database directly, with no model involved.
#
# `make gen` is the LLM path and needs one of the two providers below.

# Anthropic API - the default. Just a key.
ANTHROPIC_API_KEY=

# Or route the same models through AWS Bedrock instead. Credentials are read
# from infra/aws/.env, NOT from this file - the AWS_* values above belong to
# MinIO. Needs the extra: uv sync --extra bedrock
#LLM_PROVIDER=bedrock
#BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0
#BEDROCK_MAX_TOKENS=8000

# Or run the model locally with Ollama, so no request and no schema metadata
# leaves this machine. Needs the extra: uv sync --extra ollama
#
# The model MUST support tool calling - the generator uses structured output, and
# a model without it returns prose instead of a DAG (`ollama show <model>` lists
# capabilities; qwen3/llama3.1+/deepseek-r1 qualify, gemma3 does not).
#LLM_PROVIDER=ollama
#OLLAMA_MODEL=qwen3:8b
#OLLAMA_BASE_URL=http://localhost:11434
# Ollama defaults to 2048 tokens and silently truncates past it, which would cut
# off the source catalog the model is grounded on. Lower only if RAM-constrained.
#OLLAMA_NUM_CTX=32768

# Source database the generator introspects FROM YOUR MACHINE (defaults shown).
# Distinct from the postgres_conn_id written into the DAG, which Airflow
# resolves inside the cluster at run time.
#GENAI_SOURCE_HOST=localhost
#GENAI_SOURCE_PORT=5433
#GENAI_SOURCE_DB=bankingdb
#GENAI_SOURCE_USER=bankinguser
#GENAI_SOURCE_PASSWORD=bankingpass
#GENAI_AIRFLOW_CONN_ID=postgres_banking
